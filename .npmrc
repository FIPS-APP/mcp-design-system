# Design system FIPS no GitHub Packages (privado). O token vem do ambiente:
#   local: export NODE_AUTH_TOKEN=$(gh auth token)   (escopo read:packages)
#   CI:    GITHUB_TOKEN do workflow, com permissions.packages: read
#   build: secret do BuildKit (Dockerfile), nunca em ARG ou camada da imagem
@fips-app:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
save-exact=true
# A03: versao publicada ha menos de 7 dias nao e resolvida (pacote malicioso
# costuma ser retirado nesse prazo). O design system e interno e fica de fora.
# Vale no npm 11.10+ (workflow Lockfile); o npm 10 do `npm ci` ignora.
min-release-age=7
min-release-age-exclude[]=@fips-app/*
engine-strict=true
